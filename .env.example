# Resend — powers the Get in touch enquiry form (/api/contact).
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to business.email if unset.
# One address, or a comma-separated list to notify several people — everyone
# named is a normal To: recipient, so reply-all keeps the team on one thread.
#   CONTACT_TO_EMAIL=hello@example.com, reception@example.com
CONTACT_TO_EMAIL=

# The sender. Must be on a domain verified at https://resend.com/domains
# If unset, falls back to Resend's shared onboarding@resend.dev, which in test
# mode only delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=

# ── Analytics & Search Console ────────────────────────────────────────────
# Google Tag Manager container. GA4, Google Ads conversions and anything else
# live inside the container, not in this repo — so a new destination is a
# change in GTM, never a deploy. Leave unset to use the live container
# (GTM-MQ9RNSZP, the default in components/Analytics.tsx); set it to point a
# preview deployment at a throwaway container, or to "off" to disable tagging.
# An empty value is treated as unset and uses the live container.
NEXT_PUBLIC_GTM_ID=

# Search Console ownership token — the value from the HTML tag method, i.e.
# only the content="…" part, not the whole tag. Public by design: it proves
# control of the domain, nothing more. Leave unset if the property was verified
# by DNS record, which needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
